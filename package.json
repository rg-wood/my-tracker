{
  "name": "my-tracker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "vite",
    "start:preview": "vite preview",
    "build": "tsc -b && vite build",
    "test": "oxlint",
    "update:data": "npm run update:data:collect && npm run update:data:notes",
    "update:data:collect": "npm run update:data:notes:collect",
    "update:data:notes:collect": "ob login --email $OBSIDIAN_EMAIL --password $OBSIDIAN_PASSWORD && ob sync-setup --vault 'Notes' --path ./tmp/vault --password $OBSIDIAN_PASSWORD && ob sync --path ./tmp/vault > /dev/null",
    "update:data:notes": "node ./bin/update-notes.js './tmp/vault/🪶 Fleeting' ./data/notes.json"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@uiw/react-heat-map": "^2.3.4",
    "@vitejs/plugin-react": "^6.1.2",
    "obsidian-headless": "^0.0.14",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "typescript": "~7.0.2",
    "vite": "^8.3.4"
  },
  "allowScripts": {
    "fsevents": false,
    "better-sqlite3": false
  }
}
